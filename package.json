{
  "name": "sgfcap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a photo or scan of a go/baduk position into SGF, entirely in the browser.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "gh-pages": "pnpm build && gh-pages --dist dist --dotfiles --message \"Publish site\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixture": "tsx scripts/make-fixture.ts",
    "social": "tsx scripts/social.ts",
    "generate": "tsx scripts/generate.ts",
    "faces": "tsx scripts/facescan.ts",
    "dataset": "tsx scripts/dataset.ts",
    "train": "tsx scripts/train.ts",
    "patches": "tsx scripts/patches.ts",
    "train-gate": "tsx scripts/trainGate.ts",
    "train-stones": "tsx scripts/trainStones.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "gh-pages": "^6.3.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "besogo": "0.0.2-alpha"
  }
}
